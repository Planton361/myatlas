{
  "manifest_version": 3,
  "name": "MyAtlas LeetCode — Local Tracker",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "description": "Local owner-attested progress. Accepted observations always require confirmation.",
  "permissions": ["storage"],
  "optional_permissions": ["alarms"],
  "optional_host_permissions": ["https://api.github.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "MyAtlas local progress"},
  "content_scripts": [{
    "matches": ["https://leetcode.com/problems/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://api.github.com"}
}
